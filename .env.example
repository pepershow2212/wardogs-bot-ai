# Скопируй этот файл в .env и впиши свои данные.
# copy .env.example .env
# Файл .env в Git не попадает. Сюда секреты не пиши.

# Discord Developer Portal → приложение WARDOGS AI (не TOOLS) → Bot → Token
DISCORD_TOKEN=вставь_токен_бота_ai

# Discord Developer Portal → General Information → Application ID
# Должен быть ID WARDOGS AI, не WARDOGS TOOLS / MANAGER
DISCORD_CLIENT_ID=вставь_application_id_бота_ai

# ID Discord-сервера. Правый клик по серверу → Копировать ID (режим разработчика)
DISCORD_GUILD_ID=вставь_id_сервера

# Ключ ProxyAPI: https://console.proxyapi.ru
OPENAI_API_KEY=вставь_ключ_proxyapi
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Отвечать на @упоминания. Нужен Message Content Intent в Developer Portal
ENABLE_MENTIONS=true

# Отвечать в личке. Для серверного бота оставь false
ENABLE_DMS=false

# Каналы, где боту можно отвечать. Пусто = все публичные, кроме админки
ALLOWED_CHANNEL_IDS=

# Канал с правилами. Пусто = бот сам ищет канал «правила» / Rules
RULES_CHANNEL_IDS=
READ_CHANNEL_RULES=true

# Каналы/форумы базы знаний. Пусто = сам ищет по имени (база, faq, гайд, помощь)
KNOWLEDGE_CHANNEL_IDS=
SYNC_PUBLIC_KNOWLEDGE=true
KNOWLEDGE_SYNC_MINUTES=30

# Каналы, которые бот игнорирует (админка, тикеты, мод-логи)
ADMIN_CHANNEL_IDS=

# Пропускать каналы, в названии которых есть эти слова
STAFF_CHANNEL_PATTERNS=admin,staff,mod-log,modlog,ticket,logs

# Сколько последних сообщений брать как контекст (5–10)
MAX_CONTEXT_MESSAGES=8

# Короткая память диалога в RAM, не пишется на диск
MEMORY_TURNS=6
MEMORY_TTL_MINUTES=20

# Антиспам: запросов на пользователя в минуту
USER_RATE_LIMIT_PER_MINUTE=6

# Пауза после @упоминания: на человека и на канал (секунды)
MENTION_COOLDOWN_SECONDS=180
MENTION_CHANNEL_COOLDOWN_SECONDS=45

# Сколько запросов к ИИ сразу и размер очереди
AI_CONCURRENCY=2
MAX_QUEUE_SIZE=8
